# Copie este arquivo para ".env" e preencha.

# URL do endpoint protegido no App de Visitas (troque pelo domínio real).
API_URL=https://hygicare-visitas.vercel.app/api/pendencias-whatsapp

# Mesmo valor da env var WHATSAPP_PENDENCIAS_SECRET configurada na Vercel.
API_SECRET=

# Horário/dias da semana do envio NÃO ficam aqui — são configurados direto
# no app, em Admin > Configurações > "Avisos de pendência por WhatsApp".
# O robô busca isso a cada checagem, então ajustar lá já vale na hora.

# A cada quantos minutos o robô confere se já está na hora de mandar.
INTERVALO_CHECAGEM_MIN=5

# Porta do painel local (http://localhost:PORTA_PAINEL) com status e botão
# de parar — se mudar aqui, ajuste também a URL dentro de iniciar.bat.
PORTA_PAINEL=3344

# Intervalo entre uma mensagem e outra (milissegundos) — evita parecer
# disparo em massa. O robô ainda soma uma variação aleatória de até +50%
# em cima desse valor. 60000 = 1 min entre uma pessoa e a próxima.
DELAY_ENTRE_ENVIOS_MS=60000

# Opcional: número (com DDI, ex.: 5514999998888) que recebe por WhatsApp:
# (1) um alerta quando o robô falha repetidamente (3+ checagens seguidas) —
# ex.: API fora do ar — NÃO ajuda se o problema for a própria conexão do
# WhatsApp caindo (não dá pra avisar pelo canal que caiu); pro painel; e
# (2) um lembrete quando "Modo aprovação manual" (Admin > Configurações)
# está ligado e tem categoria esperando aprovação no painel.
ALERTA_TELEFONE=
