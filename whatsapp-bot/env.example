# Copie este arquivo para ".env" e preencha.

# URL do endpoint protegido no App de Visitas (troque pelo domínio real).
API_URL=https://hygicare-visitas.vercel.app/api/pendencias-whatsapp

# Mesmo valor da env var WHATSAPP_PENDENCIAS_SECRET configurada na Vercel.
API_SECRET=

# Janela de envio (hora local, formato HH:MM). Só manda nesse intervalo,
# de segunda a sexta. Se o computador estiver desligado nesse horário,
# manda assim que ligar, contanto que ainda esteja dentro da janela.
HORA_INICIO=08:00
HORA_LIMITE=18:00

# A cada quantos minutos o robô confere se já está na hora de mandar.
INTERVALO_CHECAGEM_MIN=5

# Intervalo entre uma mensagem e outra (milissegundos) — evita parecer
# disparo em massa. O robô ainda soma uma variação aleatória de até +50%
# em cima desse valor.
DELAY_ENTRE_ENVIOS_MS=8000
